generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. المستخدمين والصلاحيات
// ==========================================
model User {
  id           BigInt   @id
  name         String
  username     String?
  role         Role     @default(USER)
  joinedAt     DateTime @default(now())
  
  dailyGoal    Int?
  weeklyGoal   Int?
  streak       Int      @default(0)
  totalStudy   Int      @default(0)
  
  notes            Note[]
  studySessions    StudySession[]
  groupMemberships GroupMember[]
  campParticipants CampParticipant[]
}

enum Role {
  OWNER
  ADMIN
  USER
}

// ==========================================
// 2. القائمة الرئيسية والمحتوى الديناميكي
// ==========================================
model Button {
  id           Int      @id @default(autoincrement())
  name         String
  emoji        String?
  type         ButtonType
  content      String?
  order        Int      @default(0)
  isHidden     Boolean  @default(false)
  
  parentId     Int?
  parent       Button?  @relation("ButtonHierarchy", fields: [parentId], references: [id])
  children     Button[] @relation("ButtonHierarchy")

  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  deletedById  BigInt?
}

enum ButtonType {
  CONTENT
  LINK
  WEB_APP
  FUNCTION
  SECTION
}

// ==========================================
// 3. إدارة الجروبات والرتب
// ==========================================
model Group {
  id           BigInt   @id
  name         String
  addedAt      DateTime @default(now())
  isActive     Boolean  @default(true)
  
  antiSpam     Boolean  @default(false)
  antiLink     Boolean  @default(false)
  welcomeMsg   String?
  
  members      GroupMember[]
  groupCamps   GroupCamp[]
}

model GroupMember {
  id           Int       @id @default(autoincrement())
  userId       BigInt
  groupId      BigInt
  rank         GroupRank @default(NORMAL)
  warnings     Int       @default(0)
  isMuted      Boolean   @default(false)
  
  user         User      @relation(fields: [userId], references: [id])
  group        Group     @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

enum GroupRank {
  MAIN_OWNER
  OWNER
  CREATOR
  MANAGER
  ADMIN
  VIP
  NORMAL
}

// ==========================================
// 4. الملاحظات (Sticky Notes)
// ==========================================
model Note {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  text         String
  category     String?
  reminderAt   DateTime?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  isDeleted    Boolean  @default(false)
  
  user         User     @relation(fields: [userId], references: [id])
}

// ==========================================
// 5. Camp Pro (المذاكرة الفردية والجماعية)
// ==========================================
model StudySession {
  id             Int       @id @default(autoincrement())
  userId         BigInt
  startTime      DateTime  @default(now())
  endTime        DateTime?
  actualDuration Int       @default(0)
  status         SessionStatus @default(IN_PROGRESS)
  
  user           User      @relation(fields: [userId], references: [id])
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  STOPPED
}

model GroupCamp {
  id           Int      @id @default(autoincrement())
  groupId      BigInt
  messageId    BigInt
  status       CampStatus @default(ACTIVE)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  group        Group    @relation(fields: [groupId], references: [id])
  participants CampParticipant[]
}

enum CampStatus {
  ACTIVE
  ENDED
}

model CampParticipant {
  id           Int      @id @default(autoincrement())
  campId       Int
  userId       BigInt
  joinedAt     DateTime @default(now())
  leftAt       DateTime?
  studyTime    Int      @default(0)
  
  camp         GroupCamp @relation(fields: [campId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

// ==========================================
// 6. سجل العمليات (Action Logs)
// ==========================================
model ActionLog {
  id           Int      @id @default(autoincrement())
  adminId      BigInt
  action       String
  target       String?
  details      String?
  createdAt    DateTime @default(now())
}

// ==========================================
// 7. إعدادات البوت العامة (Settings)
// ==========================================
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
